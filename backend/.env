# Database Configuration (PostgreSQL URL or SQLite fallback)
# PostgreSQL example: postgresql://postgres:postgres@localhost:5432/bluegun_transfers
DATABASE_URL=sqlite:///./transfer_market.db

# Server Configuration
PORT=8000
HOST=0.0.0.0
# SECURITY: Set to False in production. Only enable for local development.
DEBUG=False

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# External API Keys (Optional - falls back to local database when empty)
FOOTBALL_API_KEY=
NEWS_API_KEY=

# Background Sync Interval (Minutes)
SYNC_INTERVAL_MINUTES=30
