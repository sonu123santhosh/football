# Database Configuration
# PostgreSQL format: postgresql://username:password@localhost:5432/database_name
# SQLite fallback: sqlite:///./transfer_market.db
DATABASE_URL=sqlite:///./transfer_market.db

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External Real-time Football & News APIs (Optional)
FOOTBALL_API_KEY=your_api_football_key_here
NEWS_API_KEY=your_news_api_key_here

# Scheduler Configuration
SYNC_INTERVAL_MINUTES=30
