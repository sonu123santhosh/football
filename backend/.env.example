# BLUEGUN — 2026 Football Transfer Intelligence Platform
# Environment Variables (Template — replace with real values for production)
#
# DO NOT commit a filled-in .env file to version control.
# Copy this file to .env and fill in the values.

# Database Configuration
# Use sqlite:///./transfer_market.db for local development
# Use a full PostgreSQL URL for production
DATABASE_URL=sqlite:///./transfer_market.db

# Server Configuration
PORT=8000
HOST=0.0.0.0
# SECURITY: Always set to False in production
DEBUG=False

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External API Keys (Optional — leave blank to use local seed database)
FOOTBALL_API_KEY=
NEWS_API_KEY=

# Secret Key (Used for signing tokens in future auth)
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# Background Sync Interval (Minutes)
SYNC_INTERVAL_MINUTES=30
